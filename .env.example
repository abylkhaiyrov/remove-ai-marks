# Optional bearer token required by the local HTTP service. Keep this file
# local after copying it to .env; do not commit the resulting .env file.
WATERMARKS_SERVER_API_KEY=

# Text rewriting is optional, but required to process a .txt file through the
# service's Layer B strategy. Uncomment and set these only after you run a
# local Ollama server with the selected model, or configure another compatible
# rewrite provider.
# WATERMARKS_REWRITE_BACKEND=ollama
# WATERMARKS_REWRITE_MODEL=llama3.2
# WATERMARKS_REWRITE_BASE_URL=http://host.docker.internal:11434
# WATERMARKS_REWRITE_ALLOW_REMOTE=1

# For an OpenAI-compatible provider, use these instead of the Ollama settings.
# Keep the API key only in your untracked .env file.
# WATERMARKS_REWRITE_BACKEND=openai-compatible
# WATERMARKS_REWRITE_MODEL=<provider-model-name>
# WATERMARKS_REWRITE_BASE_URL=https://<provider-host>/v1
# WATERMARKS_REWRITE_API_KEY=<your-api-key>
# WATERMARKS_REWRITE_ALLOW_REMOTE=1
